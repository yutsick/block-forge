{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "block-forge/stories-grid",
  "title": "Stories Grid",
  "category": "block-forge",
  "description": "Dynamic grid of posts/stories pulled from WordPress. Number of items and post type are configurable.",
  "keywords": ["stories", "testimonials", "berättelser", "posts", "query"],
  "textdomain": "block-forge",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "block-forge-style",
  "render": "file:./render.php",
  "attributes": {
    "sectionTitle": {
      "type": "string",
      "default": "Fri att vara du"
    },
    "moreLinkLabel": {
      "type": "string",
      "default": "Läs fler berättelser"
    },
    "moreLinkUrl": {
      "type": "string",
      "default": ""
    },
    "numberOfPosts": {
      "type": "number",
      "default": 3
    },
    "postType": {
      "type": "string",
      "default": "post"
    }
  }
}
