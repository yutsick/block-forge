{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "block-forge/footer",
  "title": "Footer",
  "category": "block-forge",
  "description": "Site footer with logo, description, contact info, social links and newsletter teaser",
  "keywords": ["footer", "contact", "social"],
  "textdomain": "block-forge",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "block-forge-style",
  "render": "file:./render.php",
  "attributes": {
    "description": {
      "type": "string",
      "default": "Movendi är en partipolitisk och religiöst obunden ideell medlemsrörelse som arbetar för ett fritt och rättvist samhälle."
    },
    "contactAddress": {
      "type": "string",
      "default": "Gustavslundsvägen 10, 112 66 Stockholm"
    },
    "contactEmail": {
      "type": "string",
      "default": "info@movendi.se"
    },
    "contactPhone": {
      "type": "string",
      "default": "+46 (0) 8 720 00 00"
    },
    "newsletterTitle": {
      "type": "string",
      "default": "Prenumerera på nyhetsbrevet"
    },
    "newsletterDescription": {
      "type": "string",
      "default": "Upptäck vida nyhetsbrevet och ta del av aktuella artiklar och nyheter direkt i din inkorg."
    },
    "socialFacebook": { "type": "string", "default": "" },
    "socialInstagram": { "type": "string", "default": "" },
    "socialTwitter": { "type": "string", "default": "" },
    "socialYoutube": { "type": "string", "default": "" },
    "socialLinkedin": { "type": "string", "default": "" },
    "legalLinks": {
      "type": "array",
      "default": [
        { "label": "Integritetspolicy", "url": "" },
        { "label": "Behandling av personuppgifter", "url": "" },
        { "label": "Tillgänglighetsredogörelse", "url": "" }
      ]
    }
  }
}
