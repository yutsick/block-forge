{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "block-forge/footer",
  "title": "Footer",
  "category": "block-forge",
  "description": "Site footer with logo, description, contact info, social links and newsletter teaser",
  "keywords": ["footer", "contact", "social"],
  "textdomain": "block-forge",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "block-forge-style",
  "render": "file:./render.php",
  "attributes": {
    "description": {
      "type": "string",
      "default": "Movendi är en partipolitiskt och religiöst obunden ideell medlemsorganisation och en del av den svenska nykterhetsrörelsen."
    },
    "contactAddress": {
      "type": "string",
      "default": "Gammelgårdsvägen 38, 112 64 Stockholm"
    },
    "contactEmail": {
      "type": "string",
      "default": "info@movendi.se"
    },
    "contactPhone": {
      "type": "string",
      "default": "+46 73 338 93 97"
    },
    "contactPhoneSecondary": {
      "type": "string",
      "default": "+46 72 155 50 36"
    },
    "socialTitle": {
      "type": "string",
      "default": "Sociala kanaler"
    },
    "newsletterTitle": {
      "type": "string",
      "default": "Prenumerera på nyhetsbrev"
    },
    "newsletterDescription": {
      "type": "string",
      "default": "Upptäck våra olika nyhetsbrev och få inspiration och nyheter direkt i din inkorg."
    },
    "newsletterLinkLabel": {
      "type": "string",
      "default": "Se våra nyhetsbrev"
    },
    "newsletterLinkUrl": {
      "type": "string",
      "default": ""
    },
    "socialFacebook":  { "type": "string", "default": "" },
    "socialTiktok":    { "type": "string", "default": "" },
    "socialLinkedin":  { "type": "string", "default": "" },
    "socialYoutube":   { "type": "string", "default": "" },
    "socialInstagram": { "type": "string", "default": "" },
    "legalTitle": {
      "type": "string",
      "default": "Genvägar"
    },
    "legalLinks": {
      "type": "array",
      "default": [
        { "label": "Om webbplatsen", "url": "" },
        { "label": "Behandling av personuppgifter", "url": "" },
        { "label": "Tillgänglighetsredogörelse", "url": "" }
      ]
    }
  }
}
