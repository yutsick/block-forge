{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "block-forge/services-grid",
  "title": "Informationspuffar",
  "icon": "screenoptions",
  "example": { "viewportWidth": 1200 },
  "category": "block-forge",
  "description": "2x2 grid of service cards with image, title, description, multiple links and an expandable 'show more' toggle.",
  "keywords": [
    "services",
    "stöd",
    "grid",
    "cards",
    "links"
  ],
  "textdomain": "block-forge",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "block-forge-style",
  "viewScript": "file:./view.js",
  "render": "file:./render.php",
  "attributes": {
    "sectionTitle": {
      "type": "string",
      "default": "Så kan vi stötta dig"
    },
    "sectionDescription": {
      "type": "string",
      "default": "Lorem ipsum dolor sit amet consectetur. Et ut lacus quisque consequat dolor lectus."
    },
    "backgroundColor": {
      "type": "string",
      "default": "white"
    },
    "verticalSpacing": {
      "type": "string",
      "default": "both"
    },
    "visibleLinks": {
      "type": "number",
      "default": 3
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "imageUrl": {
            "type": "string"
          },
          "imageAlt": {
            "type": "string"
          },
          "imageId": {
            "type": "number"
          },
          "title": {
            "type": "string"
          },
          "titleUrl": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "showMoreLabel": {
            "type": "string"
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "default": [
        {
          "imageUrl": "",
          "imageAlt": "",
          "imageId": 0,
          "title": "Stöd till familj och anhöriga",
