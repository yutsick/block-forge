{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "block-forge/hero",
  "title": "Hero",
  "category": "block-forge",
  "description": "Full-width hero section with video or image background, heading, description and CTA buttons",
  "keywords": ["hero", "banner", "cta", "video"],
  "textdomain": "block-forge",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "block-forge-style",
  "render": "file:./render.php",
  "attributes": {
    "bgType": {
      "type": "string",
      "default": "image"
    },
    "imageUrl": {
      "type": "string",
      "default": ""
    },
    "imageAlt": {
      "type": "string",
      "default": ""
    },
    "imageId": {
      "type": "number"
    },
    "videoUrl": {
      "type": "string",
      "default": ""
    },
    "videoId": {
      "type": "number"
    },
    "title": {
      "type": "string",
      "default": "Fri att vara du"
    },
    "description": {
      "type": "string",
      "default": "Movendi samlar människor i hela Sverige som vill ha gemenskap, stöd och roliga aktiviteter utan alkohol. Häng med och var med och ändra."
    },
    "primaryButton": {
      "type": "object",
      "default": { "label": "Bli medlem", "url": "" }
    },
    "secondaryButton": {
      "type": "object",
      "default": { "label": "Uppträck Movendi", "url": "" }
    },
    "anchorId": {
      "type": "string",
      "default": ""
    }
  }
}
