{
  "name": "block-forge",
  "version": "1.0.0",
  "description": "Custom Gutenberg blocks library",
  "private": true,
  "scripts": {
    "build": "wp-scripts build && npm run build:css",
    "start": "run-p start:js start:css",
    "start:js": "wp-scripts start",
    "start:css": "postcss tailwind.css -o build/style.css --watch",
    "build:css": "postcss tailwind.css -o build/style.css"
  },
  "devDependencies": {
    "@wordpress/scripts": "^30.0.0",
    "@tailwindcss/postcss": "^4.2.2",
    "postcss": "^8.5.8",
    "postcss-cli": "^11.0.1",
    "npm-run-all": "^4.1.5"
  }
}